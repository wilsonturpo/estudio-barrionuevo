---
import "./ContactForm.scss";

const { whatsappNumber } = Astro.props;
---

<form class="contact-form" data-contact-form data-whatsapp-number={whatsappNumber} novalidate>
  <div class="contact-form__field">
    <label for="contact-name">Nombre</label>
    <input id="contact-name" name="name" autocomplete="name" required aria-describedby="contact-privacy" />
  </div>
  <fieldset class="contact-form__field">
    <legend>Consulta como</legend>
    <div class="contact-form__options">
      <label><input type="radio" name="audience" value="Trabajador/a" required /> Trabajador/a</label>
      <label><input type="radio" name="audience" value="Empresa" required /> Empresa</label>
    </div>
  </fieldset>
  <div class="contact-form__field">
    <label for="contact-subject">Asunto</label>
    <input id="contact-subject" name="subject" autocomplete="off" required maxlength="120" placeholder="Ej.: Consulta sobre documentos laborales" />
  </div>
  <div class="contact-form__field">
    <label for="contact-description">Descripción breve</label>
    <textarea id="contact-description" name="description" required maxlength="800" rows="6" aria-describedby="contact-privacy contact-hint" placeholder="Describa el tema de manera general. No incluya DNI, archivos ni información sensible."></textarea>
    <small id="contact-hint">Máximo 800 caracteres. No adjunte documentos ni datos sensibles.</small>
  </div>
  <p class="contact-form__privacy" id="contact-privacy">Al continuar, el sitio no almacena sus respuestas. Si se configura WhatsApp, usted podrá revisar el mensaje antes de enviarlo. Consulte el <a href={`${import.meta.env.BASE_URL}politica-de-privacidad/`}>borrador de privacidad</a>.</p>
  <button class="contact-form__submit" type="submit">Preparar consulta segura <span aria-hidden="true">→</span></button>
  <p class="contact-form__status" role="status" aria-live="polite" data-contact-status></p>
</form>

<script>
  const form = document.querySelector("[data-contact-form]");
  const status = form?.querySelector("[data-contact-status]");

  if (form instanceof HTMLFormElement && status instanceof HTMLElement) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        status.textContent = "Revise los campos obligatorios antes de continuar.";
        form.querySelector(":invalid")?.focus();
        return;
      }

      const data = new FormData(form);
      const message = [
        "Hola, deseo realizar una consulta laboral.",
        `Nombre: ${data.get("name")}`,
        `Consulta como: ${data.get("audience")}`,
        `Asunto: ${data.get("subject")}`,
        `Descripción: ${data.get("description")}`,
        "\nNota: mensaje generado desde el formulario web."
      ].join("\n");
      const phone = String(form.dataset.whatsappNumber || "").replace(/\D/g, "");

      if (!/^\d{8,15}$/.test(phone)) {
        status.textContent = "Modo de demostración: el WhatsApp del estudio aún no está configurado. No se envió ni almacenó su mensaje.";
        return;
      }

      window.location.assign(`https://wa.me/${phone}?text=${encodeURIComponent(message)}`);
    });
  }
</script>
