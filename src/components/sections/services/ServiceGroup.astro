---
import "./ServiceGroup.scss";
import Card from "../../ui/card/Card.astro";
import { localUrl } from "../../../utils/links.js";

const { title, description, services } = Astro.props;
const labels = { trabajadores: "Para trabajadores", empresas: "Para empresas" };
---

<section class="service-group" aria-labelledby={`service-group-${title.toLowerCase()}`}>
  <div class="service-group__heading">
    <div>
      <p class="eyebrow">{labels[title] || title}</p>
      <h2 id={`service-group-${title.toLowerCase()}`}>{description}</h2>
    </div>
  </div>
  <div class="service-group__grid">
    {services.map((service) => (
      <Card category={labels[service.category]} title={service.title} summary={service.summary} href={localUrl(`/servicios/${service.slug}/`)} />
    ))}
  </div>
</section>
