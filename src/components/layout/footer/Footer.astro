---
import "./Footer.scss";
import { localUrl } from "../../../utils/links.js";

const { site, navigation, socialLinks } = Astro.props;
const activeSocialLinks = socialLinks.filter((item) => item.url);
---

<footer class="site-footer">
  <div class="site-footer__inner container">
    <div class="site-footer__identity">
      <p class="site-footer__brand">{site.name}</p>
      <p>{site.tagline}</p>
      <p class="site-footer__demo">{site.label}. Información sujeta a validación antes de su publicación definitiva.</p>
    </div>
    <div>
      <p class="site-footer__heading">Navegación</p>
      <ul class="site-footer__links">
        {navigation.map((item) => <li><a href={localUrl(item.path)}>{item.label}</a></li>)}
        <li><a href={localUrl("/politica-de-privacidad/")}>Privacidad</a></li>
      </ul>
    </div>
    <div>
      <p class="site-footer__heading">Contacto</p>
      <address class="site-footer__contact">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <span>{site.phone}</span>
        <span>{site.hours}</span>
      </address>
      {activeSocialLinks.length > 0 && (
        <ul class="site-footer__social">
          {activeSocialLinks.map((item) => <li><a href={item.url}>{item.label}</a></li>)}
        </ul>
      )}
    </div>
  </div>
  <div class="site-footer__bottom container">
    <span>© {new Date().getFullYear()} {site.name}. Sitio de demostración.</span>
    <span>Derecho laboral · Perú</span>
  </div>
</footer>
