---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contacto" currentPath="/contacto/" description="Información sobre los canales de contacto del estudio.">
  <section class="contact-page section section--ivory">
    <div class="container contact-page__grid">
      <div class="contact-page__intro">
        <p class="eyebrow">Contacto</p>
        <h1>Canales de contacto en actualización.</h1>
        <p>Estamos actualizando nuestros canales de atención. Esta página no solicita ni almacena información personal.</p>
        <p class="contact-page__notice">Vuelva a visitar esta sección próximamente para conocer los canales disponibles.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page__grid { display: grid; gap: var(--space-6); min-height: 46vh; }
  .contact-page h1 { margin-top: var(--space-2); max-width: 35rem; }
  .contact-page__intro > p:not(.eyebrow) { color: var(--color-text-muted); font-size: 1.1rem; margin-top: var(--space-4); max-width: 40rem; }
  .contact-page__notice { border-left: 3px solid var(--color-secondary); font-size: 0.95rem !important; padding-left: var(--space-3); }
</style>
