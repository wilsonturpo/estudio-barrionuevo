---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/sections/contact/ContactForm.astro";
import site from "../data/site.json";
---

<BaseLayout title="Contacto" currentPath="/contacto/" description="Formulario de demostración para organizar una consulta laboral inicial.">
  <section class="contact-page section section--ivory">
    <div class="container contact-page__grid">
      <div class="contact-page__intro">
        <p class="eyebrow">Contacto</p>
        <h1>Cuéntenos el tema de su consulta.</h1>
        <p>Este formulario no envía información a un servidor ni guarda sus datos. Escriba solo lo necesario para organizar una primera conversación.</p>
        <div class="contact-page__details">
          <div><span>Correo de demostración</span><a href={`mailto:${site.email}`}>{site.email}</a></div>
          <div><span>Atención</span><p>{site.hours}</p></div>
          <div><span>Modalidad</span><p>{site.location}</p></div>
        </div>
        <p class="provisional-note">{site.whatsapp.number ? "WhatsApp configurado para la consulta inicial." : "WhatsApp pendiente de configurar. El formulario se mantiene en modo de demostración y no abrirá un destino ficticio."}</p>
      </div>
      <ContactForm whatsappNumber={site.whatsapp.number} />
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page__grid { display: grid; gap: var(--space-6); }
  .contact-page h1 { margin-top: var(--space-2); max-width: 35rem; }
  .contact-page__intro > p:not(.eyebrow):not(.provisional-note) { color: var(--color-text-muted); font-size: 1.1rem; margin-top: var(--space-4); max-width: 36rem; }
  .contact-page__details { border-top: 1px solid var(--color-border); display: grid; gap: var(--space-3); margin-top: var(--space-5); padding-top: var(--space-4); }
  .contact-page__details span { color: var(--color-text-muted); display: block; font-size: 0.73rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .contact-page__details a, .contact-page__details p { color: var(--color-primary); display: block; margin-top: 0.2rem; }
  .contact-page .provisional-note { margin-top: var(--space-5); }
  @media (min-width: 64rem) { .contact-page__grid { grid-template-columns: 0.85fr 1.15fr; } }
</style>
