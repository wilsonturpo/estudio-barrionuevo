---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionTitle from "../../components/ui/section-title/SectionTitle.astro";
import ServiceGroup from "../../components/sections/services/ServiceGroup.astro";
import CallToAction from "../../components/sections/call-to-action/CallToAction.astro";
import services from "../../data/services.json";
import { localUrl } from "../../utils/links.js";

const workers = services.filter((service) => service.category === "trabajadores");
const businesses = services.filter((service) => service.category === "empresas");
---

<BaseLayout title="Servicios" currentPath="/servicios/" description="Áreas de orientación laboral para trabajadores y empresas.">
  <section class="services-heading section">
    <div class="container">
      <SectionTitle eyebrow="Servicios" title="Orientación laboral según el contexto de su consulta" intro="La información es general y no constituye asesoría individualizada ni implica resultados." headingLevel="h1" />
    </div>
  </section>
  <section class="section section--ivory">
    <div class="container">
      <ServiceGroup title="trabajadores" description="Para trabajadores" services={workers} />
      <ServiceGroup title="empresas" description="Para empresas" services={businesses} />
    </div>
  </section>
  <CallToAction title="¿No sabe por dónde empezar?" text="Identifique el área de orientación que mejor se relacione con su situación." href={localUrl("/")} label="Volver al inicio" />
</BaseLayout>
