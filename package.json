{
  "name": "estudiobarrionuevo",
  "version": "1.0.0",
  "description": "Sitio estático del Estudio Jurídico Laboral Barrio Nuevo.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "playwright test",
    "test:preview": "npm run build && playwright test --config=playwright.preview.config.js",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "audit": "lighthouse http://127.0.0.1:4323 --only-categories=performance,accessibility,best-practices,seo --output=html --output-path=docs/audits/lighthouse.html --chrome-flags=\"--headless=new\""
  },
  "keywords": [
    "astro",
    "derecho-laboral",
    "peru"
  ],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.7",
    "sass": "^1.108.1"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.68",
    "@playwright/test": "^1.65.0",
    "lighthouse": "^13.6.0"
  }
}
